HTTP_ADDR=:8080
DATABASE_URL=postgres://samnak:samnak@localhost:5432/samnak?sslmode=disable
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=samnak
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_SECRET=change-me
# Base of the links in emails. Mail goes to Mailpit (docker compose) on localhost:1025; inbox at http://localhost:8025.
# Leave SMTP_HOST empty to log mail to the server log instead of sending it.
# In development set SMTP_HOST=localhost to use Mailpit from make up (UI on :8025).
WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Samnak <no-reply@localhost>
# Optional modules to enable (task, approval, helpdesk). Core modules are always on.
MODULES_ENABLED=notify,task,approval,helpdesk
# API-wide rate limit per minute (NFR-07). A signed-in user counts against RATE_LIMIT_PER_MINUTE; a signed-out client counts against RATE_LIMIT_IP_PER_MINUTE. Login keeps its own, stricter limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_IP_PER_MINUTE=120
# Reverse proxy in front of the API, as IPs or CIDRs separated by commas, e.g. the web service of compose.prod.yml. Its X-Forwarded-For is believed when keying by client IP. Leave empty when no proxy is in front.
TRUSTED_PROXIES=
# Production stack (deploy/compose.prod.yml). The MinIO root user must equal S3_ACCESS_KEY and S3_SECRET_KEY above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Host name for automatic HTTPS in the production stack, for example chat.example.com. Leave empty for plain HTTP on port 80.
DOMAIN=
# The address users open, with the port if it is not 80 or 443, e.g. https://chat.example.com.
# Emails link here and browsers upload files through it.
PUBLIC_URL=http://localhost
# Change before the first start; the database keeps the password it was created with.
POSTGRES_PASSWORD=samnak
# The production stack's private network; change it only if it clashes with another Docker network.
STACK_SUBNET=172.28.0.0/24
