# Settings for the load stack (make load). Not a secret: the values only protect
# a throwaway stack that is torn down with its volumes at the end of the run.
# Read by compose twice: for ${...} in compose.prod.yml (--env-file) and as the
# container environment (APP_ENV_FILE, set by scripts/load/run.sh).

# Own compose project and host ports, so the stack never touches a dev stack
# on :8080, :5432, :6379 or :9000. Only the web service publishes a port.
HTTP_PORT=8090
HTTPS_PORT=8453
PUBLIC_URL=http://localhost:8090
# Two site addresses, comma-separated: the browser's (localhost) and the name the
# k6 container uses on the stack's network (web). Without the second one Caddy
# answers the k6 requests with an empty 200. Plain HTTP: no TLS for either.
DOMAIN=http://localhost, http://web
POSTGRES_PASSWORD=load-test-postgres

JWT_SECRET=load-test-only-jwt-secret-not-for-production-0123456789
S3_BUCKET=samnak
S3_ACCESS_KEY=loadtest-access
S3_SECRET_KEY=loadtest-secret-key
MINIO_ROOT_USER=loadtest-access
MINIO_ROOT_PASSWORD=loadtest-secret-key

SMTP_HOST=
MODULES_ENABLED=notify,task,approval,helpdesk

# The API rate limit (M6-12, NFR-07) stays on, so its Redis counters are part of
# what is measured, with the limits raised far above the load: 1,000 sockets and
# the REST mix all come from one client address (the k6 container).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10000000
RATE_LIMIT_IP_PER_MINUTE=10000000
